---
// Futuristic "2050" home page. Self-contained: does not use Layout.astro or global.css.
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/mpqknkob';
const title = 'Snehal Kanzariya — Web Developer | React, Astro, CRMs & AI Tools | India';
const description = 'I build modern, fast websites for businesses. React, TypeScript, Astro developer from India building websites and custom CRMs. Starting at ₹15,000 – ₹20,000 / $199 – $299.';
const canonical = 'https://snehal.dev';
const ogImage = '/og-image.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content="Snehal Kanzariya" />
    <meta name="theme-color" content="#04050d" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;600;800&family=Outfit:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
    <title>{title}</title>
    <style is:global>
body{margin:0;font-size:17px}

/* Layout: a fixed WebGL globe (beacon on India) sits behind one left-aligned column; glass panels float over it; mono HUD labels frame each section. Single dark look by choice. */
:root{
  --void:#04050d; --deep:#0a0c1f; --panel:rgba(13,16,38,.64); --line:rgba(140,160,255,.17);
  --fg:#eef0ff; --mute:#959cc6; --ion:#63e6ff; --violet:#9483ff; --flare:#ff8f66;
  --display:'Unbounded','Trebuchet MS',system-ui,sans-serif;
  --body:'Outfit','Segoe UI',system-ui,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;
  --holo:linear-gradient(100deg,var(--ion),var(--violet) 55%,var(--flare));
  color-scheme:dark;
}
html{scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
[hidden]{display:none!important}
img{max-width:100%}
body{background:var(--void);color:var(--fg);font-family:var(--body);font-size:17px;line-height:1.6;overflow-x:hidden;
  background-image:radial-gradient(60rem 40rem at 85% -10%,rgba(148,131,255,.16),transparent 60%),radial-gradient(50rem 36rem at -10% 40%,rgba(99,230,255,.08),transparent 60%)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--void)}
body::after{content:"";position:fixed;inset:0;z-index:1;pointer-events:none;opacity:.5;
  background:repeating-linear-gradient(0deg,rgba(255,255,255,.022) 0 1px,transparent 1px 4px)}
#space{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
.cur{position:fixed;left:0;top:0;width:38px;height:38px;margin:-19px 0 0 -19px;border:1px solid var(--ion);border-radius:50%;z-index:40;pointer-events:none;
  box-shadow:0 0 18px rgba(99,230,255,.35);transition:width .25s,height .25s,margin .25s,border-color .25s,opacity .3s;opacity:0}
.cur.on{opacity:.8}.cur.big{width:70px;height:70px;margin:-35px 0 0 -35px;border-color:var(--flare)}
a{color:inherit}
:focus-visible{outline:2px solid var(--ion);outline-offset:3px;border-radius:6px}
.wrap{max-width:1160px;margin-inline:auto;padding-left:max(clamp(16px,4vw,40px),env(safe-area-inset-left,0px));padding-right:max(clamp(16px,4vw,40px),env(safe-area-inset-right,0px))}
header.nav,main,footer{position:relative;z-index:2}
header.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:rgba(4,5,13,.62);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-block:12px}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;font-family:var(--display);font-weight:600;font-size:.8rem;letter-spacing:.04em}
.logo b{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:var(--holo);color:var(--void);font-size:.72rem}
.links{display:flex;gap:26px;font-family:var(--mono);font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}
.links a{text-decoration:none;color:var(--mute);transition:color .2s}.links a:hover{color:var(--ion)}
.prog{position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--holo);transform:scaleX(0);transform-origin:0 50%}
.btn{display:inline-flex;align-items:center;gap:8px;padding:13px 22px;border-radius:999px;font-family:var(--mono);font-size:.8rem;letter-spacing:.06em;text-transform:uppercase;text-decoration:none;border:1px solid var(--line);background:rgba(255,255,255,.04);color:var(--fg);transition:transform .2s,box-shadow .3s,border-color .3s;will-change:transform}
.btn:hover{border-color:var(--ion);box-shadow:0 0 28px rgba(99,230,255,.25)}
.btn.pri{background:var(--holo);color:var(--void);border-color:transparent;font-weight:500}
.btn.pri:hover{box-shadow:0 0 40px rgba(148,131,255,.55)}
.btn.sm{padding:9px 16px;font-size:.72rem}
.mono{font-family:var(--mono);font-size:.76rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mute)}
.eye{color:var(--ion);display:block;margin-bottom:14px}
h1,h2,h3{font-family:var(--display);margin:0;text-wrap:balance}
/* hero */
.hero{padding-block:clamp(44px,8vw,96px) clamp(40px,6vw,72px)}
.status{display:inline-flex;align-items:center;gap:10px;padding:7px 14px;border:1px solid var(--line);border-radius:999px;background:var(--panel);margin-bottom:26px}
.dot{width:8px;height:8px;border-radius:50%;background:var(--ion);box-shadow:0 0 0 0 rgba(99,230,255,.7);animation:ping 2s infinite}
@keyframes ping{70%{box-shadow:0 0 0 10px rgba(99,230,255,0)}100%{box-shadow:0 0 0 0 rgba(99,230,255,0)}}
h1{font-weight:800;font-size:clamp(1.9rem,6vw,4.3rem);line-height:1.08;letter-spacing:-.02em;max-width:780px}
.w{display:inline-block;overflow:hidden;vertical-align:bottom;padding-block:.1em;margin-block:-.1em}
.w i{display:inline-block;font-style:normal;animation:rise .95s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(var(--i)*75ms + 120ms)}
@keyframes rise{from{transform:translateY(110%) rotate(4deg)}to{transform:none}}
.g{background:var(--holo);background-size:200% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:rise .95s cubic-bezier(.2,.8,.2,1) both,flow 6s linear infinite alternate}
@keyframes flow{to{background-position:100% 0}}
.lede{max-width:54ch;color:var(--mute);font-size:1.1rem;margin:24px 0 30px}
.cta{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.price{margin-top:18px}
.hud{display:flex;flex-wrap:wrap;gap:8px 22px;margin-top:38px;padding-top:16px;border-top:1px solid var(--line)}
.hud span b{color:var(--fg);font-weight:500}
.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,340px);gap:clamp(24px,5vw,64px);align-items:center}
.me{position:relative;margin:0;justify-self:end;width:100%;max-width:340px;aspect-ratio:3/4;border-radius:28px;padding:3px;background:var(--holo);box-shadow:0 30px 90px -30px rgba(148,131,255,.6)}
.me img{display:block;width:100%;height:100%;object-fit:cover;border-radius:25px}
.me figcaption{position:absolute;left:14px;bottom:14px;padding:6px 12px;border-radius:999px;background:rgba(4,5,13,.72);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border:1px solid var(--line)}
.avatar{width:96px;height:96px;border-radius:50%;padding:2px;background:var(--holo);margin-bottom:18px}
.avatar img{display:block;width:100%;height:100%;border-radius:50%;object-fit:cover}
.wa{position:fixed;right:20px;bottom:20px;z-index:35;width:58px;height:58px;border-radius:50%;background:#25D366;color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 30px -6px rgba(37,211,102,.6),0 0 0 1px rgba(255,255,255,.15);transition:transform .2s,box-shadow .3s}
.wa:hover{transform:scale(1.08);box-shadow:0 14px 40px -6px rgba(37,211,102,.85)}
.wa svg{width:32px;height:32px;fill:currentColor}
@media (max-width:600px){.wa{right:14px;bottom:14px;width:54px;height:54px}}
.note{margin:12px 0 0;text-transform:none;letter-spacing:.04em}
@media (max-width:900px){.hero-grid{grid-template-columns:minmax(0,1fr)}.me{order:-1;justify-self:start;max-width:220px}}
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:34px}
.stat{padding:20px;border:1px solid var(--line);border-radius:18px;background:var(--panel);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
.stat b{display:block;font-family:var(--display);font-weight:600;font-size:clamp(1.5rem,3vw,2.2rem);line-height:1.1;font-variant-numeric:tabular-nums}
.stat span{display:block;margin-top:8px;font-weight:500}.stat small{color:var(--mute);font-size:.84rem}
/* sections */
section{padding-block:clamp(56px,9vw,120px)}
.head{margin-bottom:clamp(26px,4vw,46px);max-width:760px}
h2{font-weight:600;font-size:clamp(1.45rem,3.5vw,2.5rem);line-height:1.15;letter-spacing:-.01em}
.grid{display:grid;gap:18px}
.g3{grid-template-columns:repeat(3,minmax(0,1fr))}
.card{position:relative;min-width:0;border:1px solid var(--line);border-radius:22px;background:var(--panel);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);overflow:hidden;
  transform:perspective(900px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .25s ease-out,border-color .3s,box-shadow .3s;transform-style:preserve-3d}
.card::after{content:"";position:absolute;inset:0;pointer-events:none;opacity:0;transition:opacity .3s;
  background:radial-gradient(420px circle at var(--mx,50%) var(--my,50%),rgba(99,230,255,.16),rgba(148,131,255,.08) 40%,transparent 65%)}
.card:hover{border-color:rgba(99,230,255,.45);box-shadow:0 24px 70px -30px rgba(99,230,255,.45)}
.card:hover::after{opacity:1}
.pad{padding:26px;display:flex;flex-direction:column;gap:12px;height:100%}
h3{font-weight:600;font-size:1.05rem;line-height:1.3}
.card p{margin:0;color:var(--mute);font-size:.98rem}
.from{margin-top:auto;padding-top:10px;color:var(--ion)}
.art{position:relative;height:132px;overflow:hidden;border-bottom:1px solid var(--line);
  background:radial-gradient(circle at var(--px,70%) 45%,hsl(var(--h) 95% 66% / .55),transparent 58%),
  repeating-linear-gradient(90deg,rgba(160,175,255,.09) 0 1px,transparent 1px 26px),repeating-linear-gradient(0deg,rgba(160,175,255,.09) 0 1px,transparent 1px 26px),var(--deep)}
.art em{position:absolute;left:18px;bottom:-.24em;font:800 4.4rem/1 var(--display);font-style:normal;white-space:nowrap;color:transparent;-webkit-text-stroke:1px hsl(var(--h) 95% 78% / .6);transition:transform .6s cubic-bezier(.2,.8,.2,1)}
.card:hover .art em{transform:translateX(-18px)}
.tag{position:absolute;top:14px;left:18px;padding:4px 10px;border-radius:999px;border:1px solid var(--line);background:rgba(4,5,13,.6);color:var(--fg)}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chips span{font-family:var(--mono);font-size:.7rem;padding:3px 9px;border-radius:999px;border:1px solid var(--line);color:var(--mute)}
.live{margin-top:auto;padding-top:8px;font-family:var(--mono);font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ion);text-decoration:none}
.live::after{content:"";position:absolute;inset:0;z-index:1}
.live span{display:inline-block;transition:transform .25s}.card:hover .live span{transform:translateX(6px)}
/* about */
.about{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:clamp(20px,4vw,48px);align-items:start}
.about p{margin:0 0 16px;max-width:60ch;color:var(--mute)}.about p:first-of-type{color:var(--fg);font-size:1.12rem}
.list{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.list li{display:flex;gap:12px;align-items:baseline}
.list li::before{content:"";flex:none;width:8px;height:8px;border-radius:2px;background:var(--holo);transform:rotate(45deg) translateY(-1px)}
.rows{display:grid;gap:10px;margin-top:22px;padding-top:18px;border-top:1px solid var(--line)}
.rows div{display:flex;justify-content:space-between;gap:12px}.rows b{color:var(--fg);font-weight:500;text-align:right}
.mq{overflow:hidden;margin-top:clamp(40px,6vw,72px);border-block:1px solid var(--line);padding-block:18px;mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
.mq div{display:flex;gap:54px;width:max-content;animation:mq 26s linear infinite}
.mq span{font:800 clamp(1.4rem,4vw,2.6rem)/1 var(--display);color:transparent;-webkit-text-stroke:1px rgba(238,240,255,.55);white-space:nowrap}
.mq span:nth-child(odd){-webkit-text-stroke:0;background:var(--holo);-webkit-background-clip:text;background-clip:text}
@keyframes mq{to{transform:translateX(-50%)}}
/* contact */
.final{padding:clamp(28px,6vw,64px);border-radius:28px;border:1px solid var(--line);background:linear-gradient(140deg,rgba(99,230,255,.1),rgba(148,131,255,.1) 50%,rgba(255,143,102,.08)),var(--panel);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
.final h2{font-size:clamp(1.6rem,4.6vw,3.2rem);max-width:17ch}
.final p{color:var(--mute);max-width:46ch;margin:18px 0 28px}
footer{border-top:1px solid var(--line);padding-block:26px 34px;margin-top:40px}
footer .wrap{display:flex;flex-wrap:wrap;gap:10px 24px;justify-content:space-between}
/* scroll reveal: starts dim and offset, never hidden */
.pre{opacity:.18;transform:perspective(900px) translateY(34px) rotateX(8deg)}
.rv{transition:opacity .8s ease,transform .9s cubic-bezier(.2,.8,.2,1)}
@media (max-width:900px){.g3{grid-template-columns:repeat(2,minmax(0,1fr))}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.about{grid-template-columns:minmax(0,1fr)}}
@media (max-width:640px){.links{display:none}.g3{grid-template-columns:minmax(0,1fr)}.logo span{display:none}.stat{padding:16px}.art em{font-size:3.4rem}}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}html{scroll-behavior:auto}.pre{opacity:1;transform:none}}

.fgrid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,5vw,56px);align-items:start}
.form{display:grid;gap:8px}
.form label{margin-top:8px}
.form input,.form textarea,.form select{width:100%;padding:13px 14px;border-radius:12px;border:1px solid var(--line);background:rgba(4,5,13,.55);color:var(--fg);font:inherit;font-size:1rem;transition:border-color .2s,box-shadow .2s}
.form input:focus,.form textarea:focus,.form select:focus{outline:none;border-color:var(--ion);box-shadow:0 0 0 3px rgba(99,230,255,.18)}
.form textarea{resize:vertical}
.form button{margin-top:14px;justify-content:center;cursor:pointer}
.form button[disabled]{opacity:.6;cursor:wait}
#formMsg{min-height:1.4em;margin:6px 0 0;color:var(--ion)}
#formMsg.err{color:var(--flare)}
@media (max-width:900px){.fgrid{grid-template-columns:minmax(0,1fr)}}
    </style>
  </head>
  <body>
<canvas id="space" aria-hidden="true"></canvas>
<div class="cur" id="cur" aria-hidden="true"></div>

<header class="nav">
  <div class="wrap">
    <a class="logo" href="#top"><b>SK</b><span>Snehal Kanzariya</span></a>
    <nav class="links" aria-label="Sections"><a href="#work">Work</a><a href="#services">Services</a><a href="#about">About</a><a href="#contact">Contact</a></nav>
    <a class="btn pri sm mag" href="#contact">Get in touch</a>
  </div>
  <div class="prog" id="prog"></div>
</header>

<main id="top">
  <div class="wrap hero">
   <div class="hero-grid"><div>
    <div class="status mono"><i class="dot"></i>Available for websites, CRMs &amp; custom software</div>
    <h1 aria-label="I build websites and CRMs that bring customers to your business.">
      <span class="w"><i style="--i:0">I</i></span> <span class="w"><i style="--i:1">build</i></span> <span class="w"><i style="--i:2">websites</i></span> <span class="w"><i style="--i:3">&amp;</i></span> <span class="w"><i style="--i:4">CRMs</i></span> <span class="w"><i style="--i:5">that</i></span> <span class="w"><i style="--i:6">bring</i></span> <span class="w"><i class="g" style="--i:7">customers</i></span> <span class="w"><i style="--i:8">to</i></span> <span class="w"><i style="--i:9">your</i></span> <span class="w"><i style="--i:10">business.</i></span>
    </h1>
    <p class="lede">Fast, modern, SEO-ready websites and custom CRMs for businesses that want more customers. Built in India. Shipped worldwide.</p>
    <div class="cta"><a class="btn pri mag" href="#work">View my work</a><a class="btn mag" href="#contact">Get in touch</a></div>
    <p class="mono price">Starting at ₹20,000 · $299 for international clients</p>
   </div>
   <figure class="me"><img src="/assets/snehal.webp" alt="Portrait of Snehal Kanzariya" width="720" height="1080" fetchpriority="high" /><figcaption class="mono">Snehal · India</figcaption></figure>
   </div>
    <div class="stats">
      <div class="stat"><b data-n="6" data-s="+">6+</b><span>Projects shipped</span><small>Real clients, many under NDA</small></div>
      <div class="stat"><b data-n="5" data-s="+">5+</b><span>Years of experience</span><small>React, Astro &amp; TypeScript</small></div>
      <div class="stat"><b data-n="3" data-s="">3</b><span>Countries reached</span><small>India, Canada &amp; USA</small></div>
      <div class="stat"><b data-n="100" data-s="">100</b><span>PageSpeed score</span><small>Lighthouse performance</small></div>
    </div>
  </div>

  <section id="services"><div class="wrap">
    <div class="head rv"><span class="mono eye" data-d>// What I build</span><h2>Services that grow your business</h2></div>
    <div class="grid g3">
      <article class="card tilt rv"><div class="pad"><h3>Business Websites</h3><p>Modern, fast websites that rank on Google and convert visitors into customers. Built with Astro for maximum performance.</p><span class="mono from">From ₹20,000 / $299</span></div></article>
      <article class="card tilt rv"><div class="pad"><h3>High-Converting Landing Pages</h3><p>Single-page sites built to get leads. Perfect for product launches, local businesses, or campaigns.</p><span class="mono from">From ₹15,000 / $199</span></div></article>
      <article class="card tilt rv"><div class="pad"><h3>CRMs, AI Tools &amp; SaaS</h3><p>Custom CRMs and AI-powered web apps: client management, competitor trackers, automation tools, dashboards. Built with Claude API + React.</p><span class="mono from">From ₹50,000 / $500*</span><span class="mono note">*Final price depends on your requirements</span></div></article>
    </div>
  </div></section>

  <section id="work"><div class="wrap">
    <div class="head rv"><span class="mono eye" data-d>// My work</span><h2>Projects that actually shipped</h2></div>
    <div class="grid g3">
      <article class="card tilt rv"><div class="art" style="--h:190;--px:72%"><span class="tag mono">Client project · Featured</span><em>BRONTE</em></div><div class="pad"><h3>Bronte Movers</h3><p>Professional website for a moving company. Built for performance and local SEO, so customers find them first.</p><div class="chips"><span>React</span><span>Astro</span><span>TailwindCSS</span></div><a class="live" href="https://bronte-movers-cyrvb0ftd-snehalkanzariyas-projects.vercel.app/" target="_blank" rel="noopener">View live <span>→</span></a></div></article>
      <article class="card tilt rv"><div class="art" style="--h:255;--px:30%"><span class="tag mono">AI tool</span><em>COMPETITOR</em></div><div class="pad"><h3>CompetitorIQ</h3><p>Paste any company name and get an instant AI-powered SWOT analysis, feature comparison, and market positioning.</p><div class="chips"><span>React</span><span>Claude AI</span><span>TypeScript</span></div><a class="live" href="https://competitor-analysis-tool-roan.vercel.app/" target="_blank" rel="noopener">View live <span>→</span></a></div></article>
      <article class="card tilt rv"><div class="art" style="--h:18;--px:60%"><span class="tag mono">SaaS tool</span><em>RESUME</em></div><div class="pad"><h3>Resume Builder</h3><p>Create professional resumes in minutes. Form-based builder with PDF export and multiple clean templates.</p><div class="chips"><span>React</span><span>TypeScript</span><span>PDF Export</span></div><a class="live" href="https://resume-builder-lovat-mu.vercel.app/" target="_blank" rel="noopener">View live <span>→</span></a></div></article>
