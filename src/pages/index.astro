    <script is:inline>
(function(){
  var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var fine = matchMedia('(hover:hover) and (pointer:fine)').matches;
  var $ = function(s){return Array.prototype.slice.call(document.querySelectorAll(s))};
  var clamp = function(v,a,b){return Math.min(b,Math.max(a,v))};

  // scroll state
  var prog = document.getElementById('prog'), sp = 0, heroE = 0;
  function onScroll(){
    var max = document.documentElement.scrollHeight - innerHeight;
    sp = max>0 ? clamp(scrollY/max,0,1) : 0;
    heroE = clamp(scrollY/(innerHeight*0.9),0,1);
    prog.style.transform = 'scaleX('+sp+')';
  }
  addEventListener('scroll',onScroll,{passive:true}); onScroll();

  // decode effect for mono labels
  var G = '01<>/#*+=_';
  function decode(el){
    if(still) return;
    var s = el.dataset.t || (el.dataset.t = el.textContent), f = 0;
    (function step(){
      f++; var k = Math.floor(f/2), out='';
      for(var i=0;i<s.length;i++) out += (i<k || s[i]===' ') ? s[i] : G[Math.floor(Math.random()*G.length)];
      el.textContent = out;
      if(k < s.length) requestAnimationFrame(step); else el.textContent = s;
    })();
  }

  // reveal on scroll (elements start dim, never hidden)
  if(!still && 'IntersectionObserver' in window){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(!e.isIntersecting) return;
        e.target.classList.remove('pre'); io.unobserve(e.target);
        var d = e.target.querySelector('[data-d]'); if(d) decode(d);
      });
    },{threshold:.12});
    $('.rv').forEach(function(el,i){
      if(el.getBoundingClientRect().top > innerHeight*0.92){ el.classList.add('pre'); el.style.transitionDelay = (i%3)*90+'ms'; }
      io.observe(el);
    });
  }

  // stat count-up
  if(!still) $('.stat b').forEach(function(el){
    var n = +el.dataset.n, s = el.dataset.s, t0 = performance.now();
    (function up(now){
      var p = clamp((now-t0)/1400,0,1), e = 1-Math.pow(1-p,3);
      el.textContent = Math.round(n*e)+s;
      if(p<1) requestAnimationFrame(up);
    })(t0);
  });

  // pointer: tilt cards, magnetic buttons, cursor ring
  var mx = 0, my = 0;
  if(fine && !still){
    var cur = document.getElementById('cur'), cx = 0, cy = 0, tx = 0, ty = 0;
    addEventListener('pointermove',function(e){
      tx = e.clientX; ty = e.clientY; cur.classList.add('on');
      mx = e.clientX/innerWidth*2-1; my = e.clientY/innerHeight*2-1;
    },{passive:true});
    (function follow(){ cx += (tx-cx)*.18; cy += (ty-cy)*.18; cur.style.transform='translate('+cx+'px,'+cy+'px)'; requestAnimationFrame(follow); })();
    $('a,button').forEach(function(a){
      a.addEventListener('pointerenter',function(){cur.classList.add('big')});
      a.addEventListener('pointerleave',function(){cur.classList.remove('big')});
    });
    $('.tilt').forEach(function(c){
      c.addEventListener('pointermove',function(e){
        var r = c.getBoundingClientRect(), x = (e.clientX-r.left)/r.width, y = (e.clientY-r.top)/r.height;
        c.style.setProperty('--ry',((x-.5)*10).toFixed(2)+'deg');
        c.style.setProperty('--rx',((.5-y)*10).toFixed(2)+'deg');
        c.style.setProperty('--mx',(x*100).toFixed(1)+'%'); c.style.setProperty('--my',(y*100).toFixed(1)+'%');
      });
      c.addEventListener('pointerleave',function(){c.style.setProperty('--rx','0deg');c.style.setProperty('--ry','0deg')});
    });
    $('.mag').forEach(function(b){
      b.addEventListener('pointermove',function(e){
        var r = b.getBoundingClientRect();
        b.style.transform = 'translate('+((e.clientX-r.left-r.width/2)*.22).toFixed(1)+'px,'+((e.clientY-r.top-r.height/2)*.3).toFixed(1)+'px)';
      });
      b.addEventListener('pointerleave',function(){b.style.transform=''});
    });
  }

  // WebGL scene: lattice globe, India beacon, signal arcs, starfield
  var canvas = document.getElementById('space');
  function initGL(){
  try{
    var T = THREE, renderer = new T.WebGLRenderer({canvas:canvas,antialias:true,alpha:true});
    renderer.setPixelRatio(Math.min(devicePixelRatio||1,1.75));
    var scene = new T.Scene(), cam = new T.PerspectiveCamera(45,1,.1,120); cam.position.z = 6;
    var R = 1.6, ION = 0x63e6ff, VIO = 0x9483ff, FLA = 0xff8f66;
    var ll = function(lat,lon,r){
      var ph = (90-lat)*Math.PI/180, th = (lon+180)*Math.PI/180;
      return new T.Vector3(-r*Math.sin(ph)*Math.cos(th), r*Math.cos(ph), r*Math.sin(ph)*Math.sin(th));
    };
    var globe = new T.Group(), spin = new T.Group(); globe.add(spin); scene.add(globe);

    var pts = [];
    for(var lat=-85; lat<=85; lat+=4){
      var n = Math.max(6,Math.round(92*Math.cos(lat*Math.PI/180)));
      for(var i=0;i<n;i++){ var v = ll(lat,i/n*360-180,R); pts.push(v.x,v.y,v.z); }
    }
    var pg = new T.BufferGeometry(); pg.setAttribute('position',new T.Float32BufferAttribute(pts,3));
    spin.add(new T.Points(pg,new T.PointsMaterial({color:ION,size:.022,transparent:true,opacity:.85,blending:T.AdditiveBlending,depthWrite:false})));
    spin.add(new T.Mesh(new T.SphereGeometry(R*.985,48,48),new T.MeshBasicMaterial({color:0x060818})));

    var ringMat = new T.LineBasicMaterial({color:VIO,transparent:true,opacity:.22});
    [-45,0,45].forEach(function(la){
      var a=[]; for(var j=0;j<=96;j++) a.push(ll(la,j/96*360-180,R*1.002));
      spin.add(new T.Line(new T.BufferGeometry().setFromPoints(a),ringMat));
    });

    globe.add(new T.Mesh(new T.SphereGeometry(R*1.2,48,48),new T.ShaderMaterial({
      side:T.BackSide,transparent:true,blending:T.AdditiveBlending,depthWrite:false,
      uniforms:{c:{value:new T.Color(VIO)}},
      vertexShader:'varying vec3 n;void main(){n=normalize(normalMatrix*normal);gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}',
      fragmentShader:'uniform vec3 c;varying vec3 n;void main(){float i=pow(max(0.,-n.z),1.6)*1.25;gl_FragColor=vec4(c*i,i);}'
    })));

    // India beacon
    var home = ll(22.3039,70.8022,R*1.006), up = home.clone().normalize();
    var core = new T.Mesh(new T.SphereGeometry(.035,16,16),new T.MeshBasicMaterial({color:FLA})); core.position.copy(home); spin.add(core);
    var pulses = [0,.5].map(function(off){
      var m = new T.Mesh(new T.RingGeometry(.05,.062,48),new T.MeshBasicMaterial({color:FLA,transparent:true,side:T.DoubleSide,depthWrite:false}));
      m.position.copy(home); m.quaternion.setFromUnitVectors(new T.Vector3(0,0,1),up); m.userData.off = off; spin.add(m); return m;
    });

    // signal arcs leaving India
    var arcMat = new T.LineBasicMaterial({color:ION,transparent:true,opacity:.4,blending:T.AdditiveBlending,depthWrite:false});
    var sparks = [[40.7,-74],[51.5,-.1],[43.65,-79.4],[-33.9,151.2],[1.35,103.8],[25.2,55.3],[37.8,-122.4],[52.5,13.4]].map(function(d,k){
      var b = ll(d[0],d[1],R*1.006), mid = home.clone().add(b).multiplyScalar(.5), dist = home.distanceTo(b);
      mid.normalize().multiplyScalar(R*(1.05+dist*.3));
      var curve = new T.QuadraticBezierCurve3(home,mid,b);
      spin.add(new T.Line(new T.BufferGeometry().setFromPoints(curve.getPoints(64)),arcMat));
      var s = new T.Mesh(new T.SphereGeometry(.024,10,10),new T.MeshBasicMaterial({color:0xffffff})); spin.add(s);
      return {m:s,c:curve,o:k/8,v:.16+k%3*.04};
    });

    // starfield
    var sv = [];
    for(var q=0;q<1100;q++){
      var r = 10+Math.random()*26, a1 = Math.random()*Math.PI*2, a2 = Math.acos(2*Math.random()-1);
      sv.push(r*Math.sin(a2)*Math.cos(a1), r*Math.cos(a2), r*Math.sin(a2)*Math.sin(a1));
    }
    var sg = new T.BufferGeometry(); sg.setAttribute('position',new T.Float32BufferAttribute(sv,3));
    var stars = new T.Points(sg,new T.PointsMaterial({color:0xeef0ff,size:.07,transparent:true,opacity:.75,depthWrite:false})); scene.add(stars);

    var wide = true;
    function size(){
      var w = innerWidth, h = innerHeight; wide = w >= 900;
      renderer.setSize(w,h,false); cam.aspect = w/h; cam.updateProjectionMatrix();
    }
    addEventListener('resize',size); size();

    var e = heroE, px = 0, py = 0;
    function draw(now){
      var t = now/1000;
      e += (heroE-e)*.08; px += (mx-px)*.05; py += (my-py)*.05;
      var sc = wide ? 1 : .68;
      globe.scale.setScalar(sc*(1+e*.15));
      globe.position.set((wide?2.25:.5)*(1-e), (wide?-.05:.35)*(1-e), -3.2*e);
      globe.rotation.x = .34 + py*.12;
      spin.rotation.y = Math.PI+.25 + Math.sin(t*.14)*.55 + sp*5 + px*.25;
      cam.position.x = px*.25; cam.position.y = -py*.18; cam.lookAt(0,0,0);
      stars.rotation.y = t*.012 + sp*.9; stars.rotation.x = sp*.5; stars.position.z = sp*7;
      pulses.forEach(function(m){ var k = (t*.55+m.userData.off)%1; m.scale.setScalar(1+k*5); m.material.opacity = 1-k; });
      core.scale.setScalar(1+Math.sin(t*4)*.25);
      sparks.forEach(function(s){ s.m.position.copy(s.c.getPoint((t*s.v+s.o)%1)); });
      canvas.style.opacity = (wide?1:.42) - e*(wide?.62:.2);
      renderer.render(scene,cam);
      if(!still) requestAnimationFrame(draw);
    }
    requestAnimationFrame(draw);
    if(still) addEventListener('resize',function(){requestAnimationFrame(draw)});
  }catch(err){ canvas.hidden = true; }
  }
  function loadGL(){
    var s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
    s.onload = initGL; s.onerror = function(){ canvas.hidden = true; };
    document.head.appendChild(s);
  }
  if(document.readyState === 'complete') loadGL(); else addEventListener('load', loadGL);

  // contact form (Formspree)
  var form = document.getElementById('contactForm'), msg = document.getElementById('formMsg'), sb = document.getElementById('submitBtn');
  form.addEventListener('submit', function(ev){
    ev.preventDefault();
    sb.disabled = true; msg.className = 'mono'; msg.textContent = 'Sending...';
    fetch(form.action, {method:'POST', body:new FormData(form), headers:{Accept:'application/json'}})
      .then(function(r){ if(!r.ok) throw 0; form.reset(); msg.textContent = "Message sent. I'll reply within 24 hours."; })
      .catch(function(){ msg.className = 'mono err'; msg.textContent = 'Could not send. Please message me on WhatsApp (+91 81283 53355) instead.'; })
      .then(function(){ sb.disabled = false; });
  });
})();
